{
  "name": "vibe-roast",
  "version": "0.98.5",
  "description": "Local-first AI coding personality profiler, usage dashboard, and evidence-grounded roast.",
  "type": "commonjs",
  "bin": {
    "vibe-roast": "bin/vibe-roast.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PinkR1ver/vibe-roast.git"
  },
  "homepage": "https://github.com/PinkR1ver/vibe-roast#readme",
  "bugs": {
    "url": "https://github.com/PinkR1ver/vibe-roast/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "cursor",
    "developer-tools",
    "roast"
  ],
  "files": [
    "bin/",
    "src/",
    "worker/README.md",
    "worker/package.json",
    "worker/package-lock.json",
    "worker/wrangler.jsonc",
    "worker/src/",
    "dashboard/dist/",
    "assests/characters/",
    "assests/characters-vibe-types/",
    "assests/readme/",
    "assests/screenshots/",
    "README.md"
  ],
  "scripts": {
    "format:check": "node scripts/quality/changed-files.mjs format",
    "lint": "node scripts/quality/changed-files.mjs lint",
    "test": "node --test test/*.test.js",
    "test:coverage": "node scripts/quality/coverage.mjs",
    "audit:dependencies": "node scripts/quality/audit-dependencies.mjs",
    "inspect": "node bin/vibe-roast.js inspect",
    "serve": "node bin/vibe-roast.js serve",
    "worker:login": "npm --prefix worker run login",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "worker:secret:github": "npm --prefix worker run secret:github",
    "worker:secret:session": "npm --prefix worker run secret:session",
    "build": "cd dashboard && npm install && npm run build",
    "dev": "cd dashboard && npm run dev",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tokentracker-cli": "^0.93.7"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "11.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "prettier": "3.9.6"
  }
}
